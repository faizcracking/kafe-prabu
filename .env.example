# ===== SUPABASE (Project Settings > API) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-public-key
# RAHASIA! Hanya dipakai di server. JANGAN diberi awalan NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=isi-dengan-service-role-key

# ===== URL WEBSITE (dipakai untuk isi QR Code meja) =====
# Lokal: http://localhost:3000 | Setelah deploy: https://nama-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Hanya untuk `npm run create-admin` (boleh dihapus setelah admin dibuat) =====
